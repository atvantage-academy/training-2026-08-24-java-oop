@startuml
title Banking – Objekte am Ende von main() (Stand PR #7)

!pragma layout smetana
left to right direction

package "main() – lokale Variablen" {
    object "myBank : Bank" as v_myBank
    object "bank2 : Bank" as v_bank2
    object "ada : Kunde" as v_ada
    object "alan : Kunde" as v_alan
    object "adaGiro : Girokonto" as v_adaGiro
    object "adaSpar : Konto" as v_adaSpar
    object "alanGiro : Girokonto" as v_alanGiro
}

object ":Bank" as b1
object ":Konto[200]" as b1konten {
    [0] = Referenz
    [1] = Referenz
    [2] = Referenz
    [3] … [199] = null
}
object ":Kunde[100]" as b1kunden {
    [0] = Referenz
    [1] = Referenz
    [2] … [99] = null
}

object ":Bank" as b2
object ":Konto[100]" as b2konten {
    [0] … [99] = null
}
object ":Kunde[50]" as b2kunden {
    [0] … [49] = null
}

object ":Kunde" as k1 {
    nummer = 1001
    birthdate = 1970-01-01
    name = "Ada Lovelace"
    wohnort = "Paris"
}
object ":Kunde" as k2 {
    nummer = 1002
    birthdate = 1995-07-15
    name = "Alan Turing"
    wohnort = "Wilmslow"
}

object ":Girokonto" as g1 {
    iban = "DE02 1203 0000 0000 2020 51"
    standInCent = -50000
    dispoLimitInCent = 50000
}
object ":Sparkonto" as s1 {
    iban = "DE02 5001 0517 0648 4898 90"
    standInCent = 250000
    habenZins = 1.5
}
object ":Girokonto" as g2 {
    iban = "DE02 1001 0010 0000 0123 45"
    standInCent = 8000
    dispoLimitInCent = 5000
}

v_myBank -[#1565C0]-> b1
v_bank2 -[#1565C0]-> b2
v_ada -[#1565C0]----> k1
v_alan -[#1565C0]----> k2
v_adaGiro -[#1565C0]---> g1
v_adaSpar -[#1565C0]---> s1
v_alanGiro -[#1565C0]---> g2

b1 --> b1konten : konten
b1 --> b1kunden : kunden
b2 --> b2konten : konten
b2 --> b2kunden : kunden

b1konten -[#2E7D32,bold]-> g1 : <color:#2E7D32>konten[0]</color>
b1konten -[#2E7D32,bold]-> s1 : <color:#2E7D32>konten[1]</color>
b1konten -[#2E7D32,bold]-> g2 : <color:#2E7D32>konten[2]</color>
b1kunden -[#2E7D32,bold]-> k1 : <color:#2E7D32>kunden[0]</color>
b1kunden -[#2E7D32,bold]-> k2 : <color:#2E7D32>kunden[1]</color>

g1 --> k1 : inhaber
s1 --> k1 : inhaber
g2 --> k2 : inhaber

note bottom of k1
    4 Referenzen auf dasselbe Objekt:
    ada, kunden[0],
    adaGiro.inhaber, adaSpar.inhaber
end note

note top of b2
    bank2 = new Bank():
    nichts hinzugefügt,
    Arrays bleiben leer
end note

note right of s1
    Variable adaSpar ist vom Typ Konto,
    das Objekt ist ein Sparkonto.
end note

legend bottom left
    <color:#1565C0>——</color>  Referenz aus einer lokalen Variable von main()
    <color:#2E7D32>——</color>  Referenz aus dem Array der Bank – entsteht durch
          myBank.addKonto(...) bzw. myBank.addKunde(...)
    ——  Referenz aus einem Feld (konten, kunden, inhaber)
endlegend

@enduml
